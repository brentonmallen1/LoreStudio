#!/usr/bin/env bash
# Pre-commit hook. Install with `just hooks`. Runs only the instant checks
# (file-length budget, ruff). eslint/tsc/prettier/tests live in `just ci`,
# because a 30-second hook is one people bypass. Skip once with --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
run() { local label="$1"; shift; if ! out=$("$@" 2>&1); then printf '\n  ✗ %s\n\n%s\n' "$label" "$out"; fail=1; fi; }
run "file-length budget (scripts/check-size.py)" python3 scripts/check-size.py
if command -v uv >/dev/null 2>&1; then
  run "ruff check"  bash -c 'cd backend && uv run ruff check app/ tests/'
  run "ruff format" bash -c 'cd backend && uv run ruff format --check app/ tests/'
fi
if [ "$fail" -ne 0 ]; then
  printf '\npre-commit failed. Fix the above, or `git commit --no-verify` to skip.\nRun `just ci` before pushing.\n\n'
  exit 1
fi
