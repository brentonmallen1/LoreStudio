    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.12.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.1",
    "d3-path": "^3.1.1",
    "d3-shape": "^3.2.1",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
