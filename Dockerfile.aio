# LoreStudio all-in-one: the API and the web front in one container under s6-overlay, one
# port, one /data volume (the SQLite database, uploads, snapshots, backups). Ollama stays
# outside (OLLAMA_BASE_URL). Built from the repository root.
#
#   docker build -f Dockerfile.aio -t lorestudio .
#   docker run -d -p 8080:8080 -e ADMIN_PASSWORD=... -v ./data:/data lorestudio
#
# Optional: SECRET_KEY (made once and kept in /data when not given), PUID/PGID (the owner of
# /data; Unraid uses 99/100), WEB_PORT, TZ, and every variable in docs/CONFIGURATION.md.

# ── The web front ──
FROM node:26-alpine AS frontend
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

# ── The API's dependencies, from the lockfile ──
FROM python:3.13-slim AS backend
COPY --from=ghcr.io/astral-sh/uv:0.12.23 /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY backend/ ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
RUN chmod -R a+rX /app

# ── Runtime ──
FROM python:3.13-slim

ARG S6_OVERLAY_VERSION=3.2.0.2
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends xz-utils wget ca-certificates && \
    S6_ARCH=$(case "$TARGETARCH" in arm64) echo aarch64;; amd64) echo x86_64;; *) echo "$TARGETARCH";; esac) && \
    wget -qO /tmp/s6-noarch.tar.xz "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-noarch.tar.xz" && \
    wget -qO /tmp/s6-arch.tar.xz "https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}/s6-overlay-${S6_ARCH}.tar.xz" && \
    tar -C / -Jxpf /tmp/s6-noarch.tar.xz && tar -C / -Jxpf /tmp/s6-arch.tar.xz && \
    rm /tmp/s6-*.tar.xz && \
    apt-get purge -y xz-utils wget && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

# nginx; pandoc for DOCX/EPUB export; pango and harfbuzz for WeasyPrint's PDF export.
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    pandoc \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    shared-mime-info \
    fonts-liberation \
    tzdata \
    && rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled/default

RUN groupadd -g 1000 lorestudio && useradd -u 1000 -g lorestudio -M -d /data -s /usr/sbin/nologin lorestudio

COPY --from=backend /app /app
COPY --from=frontend /app/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/lorestudio.conf.template
COPY aio/s6-rc.d /etc/s6-overlay/s6-rc.d
COPY aio/scripts /etc/s6-overlay/scripts
RUN chmod +x /etc/s6-overlay/scripts/* && mkdir -p /data

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION} \
    ENV=prod \
    PATH=/app/.venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WEB_PORT=8080 \
    DATABASE_URL=sqlite:////data/lorestudio.db \
    SNAPSHOTS_PATH=/data/snapshots \
    UPLOADS_PATH=/data/uploads \
    BACKUPS_PATH=/data/backups \
    S6_KEEP_ENV=1 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2 \
    S6_CMD_WAIT_FOR_SERVICES_MAXTIME=120000

VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"WEB_PORT\", \"8080\")}/api/health', timeout=4)"
ENTRYPOINT ["/init"]
