# ── Database ──────────────────────────────────────────────────────────────────
# A slash anchors the pattern to the repo root, so this must spell out the real
# location (backend/data/) rather than "data/*.db" — that never matched anything.
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ───────────────────────────────────────────────────────────────────
