# ─────────────────────────────────────────────
# LoreStudio — Environment Configuration
# ─────────────────────────────────────────────
# Copy this to .env and fill in your values.

# Server
PORT=8000
FRONTEND_PORT=5173
TZ=America/Los_Angeles

# Paths (bind mounts — override for Unraid deployment)
DATA_PATH=./data
CONFIG_PATH=./config

# Environment: dev | prod. In prod the backend refuses to start with default secrets.
ENV=dev

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin credentials (initial superuser, set on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# LLM — Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TEMPERATURE=1.0
OLLAMA_KEEP_ALIVE=10m   # How long to keep the model loaded after a request (e.g. 5m, 10m, 1h, -1 for forever)

# Database and files
DATABASE_URL=sqlite:///./data/lorestudio.db
SNAPSHOTS_PATH=./data/snapshots
UPLOADS_PATH=./data/uploads
BACKUPS_PATH=./data/backups
AUTO_MIGRATE=true          # run Alembic migrations on start
DB_BACKUP_ENABLED=true     # nightly SQLite backup into BACKUPS_PATH
DB_BACKUP_KEEP=14          # how many nightly backups to keep

# Demo content (only seeded into an empty database)
SEED_DEMO=true             # "The Last Lighthouse"
SEED_EXTRA_DEMOS=false     # the other four demo stories
