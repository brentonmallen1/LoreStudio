# ─────────────────────────────────────────────
# LoreStudio — Environment Configuration
# ─────────────────────────────────────────────
# Copy this to .env and fill in your values.

# Server
PORT=8000
FRONTEND_PORT=5173
TZ=America/Los_Angeles

# Paths (bind mounts — override for Unraid deployment)
DATA_PATH=./data
CONFIG_PATH=./config

# Security
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Admin credentials (initial superuser, set on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# LLM — Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TEMPERATURE=0.8
OLLAMA_KEEP_ALIVE=10m   # How long to keep the model loaded after a request (e.g. 5m, 10m, 1h, -1 for forever)

# Database
DATABASE_URL=sqlite:///./data/lorestudio.db
