# ─────────────────────────────────────────────
# LoreStudio — environment
# ─────────────────────────────────────────────
# Copy to .env (`just init-env`) and fill in. Every variable is described in
# docs/CONFIGURATION.md; the Docker images set the data paths themselves.

# Environment: dev | prod. In prod the app refuses to start with default secrets.
ENV=dev
LOG_LEVEL=INFO

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Browser origins allowed to call the API directly (from source: the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# The admin account, created on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# AI — Ollama (in Docker with Ollama on the host: http://host.docker.internal:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
OLLAMA_TEMPERATURE=1.0
OLLAMA_TOP_P=0.95
OLLAMA_TOP_K=64
OLLAMA_KEEP_ALIVE=10m        # how long the model stays loaded (5m, 1h, -1 for always)
OLLAMA_THINKING_ENABLED=false

# Data (running from source; the images use /data or /app/data)
DATABASE_URL=sqlite:///./data/lorestudio.db
SNAPSHOTS_PATH=./data/snapshots
UPLOADS_PATH=./data/uploads
BACKUPS_PATH=./data/backups
AUTO_MIGRATE=true            # migrate the database on start
DB_BACKUP_ENABLED=true       # starting value of Settings › Automatic work › Database backup
DB_BACKUP_KEEP=14            # backups it keeps, to begin with
AI_PAYLOAD_RETENTION_DAYS=90 # days to keep AI prompt/reply text (0 = keep)

# Demo stories (only into an empty database)
SEED_DEMO=true               # "The Last Lighthouse"
SEED_EXTRA_DEMOS=false       # the other demos and the Lighthouse's sequel (a series)

# ── Running from source (just dev): the API's port and Vite's ──
PORT=8000
FRONTEND_PORT=5173

# ── Docker (docker-compose.yml, docker-compose.aio.yml): where the app is served, the
# host folder for its data, and the timezone ──
WEB_PORT=8080
DATA_PATH=./data
TZ=UTC
# PUID=1000                  # all-in-one: who owns the data folder (Unraid: 99)
# PGID=1000                  # (Unraid: 100)
# LORESTUDIO_TAG=latest      # which published image to run
